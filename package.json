{
  "name": "siyuan-damophus",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "Damophus 思源题库与工具插件",
  "repository": "https://github.com/HibernalGlow/siyuan-damophus",
  "homepage": "https://github.com/HibernalGlow/siyuan-damophus",
  "author": "HibernalGlow",
  "license": "WTFPL",
  "scripts": {
    "make-link": "node  --no-warnings ./scripts/make_dev_link.js",
    "dev": "vite --config vite.dev.config.ts",
    "dev:plugin": "vite build --watch",
    "build": "vite build",
    "deploy:main": "vite build && node scripts/deploy-test-workspace.mjs --workspace D:/1STUDY/SIYUAN",
    "deploy:test": "vite build && node scripts/deploy-test-workspace.mjs",
    "check": "svelte-check --config ./svelte.config.js --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:agent": "pnpm --filter @hibernalglow/damophus-agent-contract test && pnpm --filter @hibernalglow/damophus-cli test",
    "build:cli": "pnpm --filter @hibernalglow/damophus-cli build",
    "test:core": "vitest run src/question-bank",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:package": "node scripts/validate-package.mjs",
    "export:tinybase-inventory": "node scripts/run-ts.mjs scripts/export-av-inventory.ts",
    "migrate:tinybase": "node scripts/run-ts.mjs scripts/migrate-av-to-tinybase.ts",
    "release": "bash ./update-version.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/svelte": "5.0.8",
    "@types/mdast": "^4.0.4",
    "@types/minimist": "1.2.5",
    "@types/node": "^20.3.0",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.1",
    "fast-glob": "^3.2.12",
    "glob": "^10.0.0",
    "js-yaml": "^4.1.0",
    "minimist": "^1.2.8",
    "playwright": "1.62.1",
    "rollup-plugin-livereload": "^2.0.5",
    "sass": "^1.63.3",
    "siyuan": "1.1.8",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "tailwindcss": "4.3.3",
    "ts-node": "^10.9.1",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vite-plugin-static-copy": "4.1.1",
    "vite-plugin-zip-pack": "^1.0.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@hibernalglow/damophus-agent-contract": "workspace:*",
    "@frostime/siyuan-plugin-kits": "^1.5.14",
    "@internationalized/date": "^3.12.0",
    "@siyuan-community/siyuan-sdk": "^0.3.14",
    "bits-ui": "^2.16.3",
    "broadcast-channel": "^7.4.0",
    "clsx": "2.1.1",
    "consola": "^3.4.2",
    "lucide-svelte": "0.545.0",
    "mdast-util-to-string": "^4.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "tailwind-merge": "3.5.0",
    "tailwind-variants": "^3.3.0",
    "tinybase": "9.3.0",
    "unified": "^11.0.5",
    "xstate": "^5.32.5",
    "zod": "^4.4.3"
  }
}
